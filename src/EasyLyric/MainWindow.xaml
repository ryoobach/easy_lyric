<Window x:Class="EasyLyric.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Easy Lyric" Height="820" Width="1180" MinHeight="680" MinWidth="900"
 WindowStartupLocation="CenterScreen" Background="#111827" Foreground="#F9FAFB">
 <Grid Margin="22">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Grid Grid.Row="0" Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="Easy Lyric" FontSize="30" FontWeight="Bold"/>
    <TextBlock Text="CJ를 위한 실시간 가사 · 기타 코드 · 악보 도우미" Foreground="#9CA3AF" FontSize="13" Margin="1,4,0,0"/>
   </StackPanel>
   <Border Grid.Column="1" Background="#163B2A" CornerRadius="14" Padding="15,7" VerticalAlignment="Center">
    <TextBlock Text="●  무음 모니터링" Foreground="#86EFAC" FontWeight="SemiBold"/>
   </Border>
  </Grid>

  <Border Grid.Row="1" Background="#202733" CornerRadius="12" Padding="14" Margin="0,0,0,16">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="방송 주소" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,14,0"/>
    <ComboBox x:Name="AddressCombo" Grid.Column="1" Height="38" IsEditable="True" IsTextSearchEnabled="False"
     VerticalContentAlignment="Center" FontSize="14" Background="#111827" Foreground="#111827"
     ToolTip="인라이브 방송 주소를 입력하거나 오른쪽 화살표로 이전 주소를 선택하세요."/>
    <Button x:Name="ConnectButton" Grid.Column="2" Content="방송 연결" Width="112" Height="38" Margin="12,0,0,0"
     Background="#16A34A" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="ConnectButton_Click"/>
   </Grid>
  </Border>

  <Grid Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="1.1*"/><RowDefinition Height="0.9*"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="#202733" CornerRadius="12" Padding="20" Margin="0,0,0,14">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="현재 재생 곡" Foreground="#9CA3AF" FontSize="12"/>
      <TextBlock x:Name="SongTitleText" Text="방송에 연결하면 곡 정보가 표시됩니다" FontSize="21" FontWeight="Bold" Margin="0,5,0,0"/>
      <TextBlock x:Name="ArtistText" Text="가수 정보 대기 중" Foreground="#9CA3AF" Margin="0,3,0,0"/>
     </StackPanel>
     <Border Grid.Row="1" Background="#111827" CornerRadius="9" Padding="20" Margin="0,18,0,0">
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="실시간 가사" Foreground="#9CA3AF" FontSize="13" Margin="0,0,0,16"/>
       <TextBlock Text="가사 검색 후 현재 부르는 부분이 이곳에 강조됩니다." FontSize="22" FontWeight="Bold"
        Foreground="#86EFAC" TextWrapping="Wrap" TextAlignment="Center"/>
       <TextBlock Text="다음 가사 구절은 아래에 이어서 표시됩니다." Foreground="#9CA3AF" FontSize="15"
        TextAlignment="Center" Margin="0,15,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>

   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#202733" CornerRadius="12" Padding="18" Margin="0,0,7,0">
     <StackPanel>
      <TextBlock Text="기타 코드" FontSize="17" FontWeight="Bold" Margin="0,0,0,18"/>
      <UniformGrid Columns="4">
       <Border Background="#111827" CornerRadius="8" Padding="8" Margin="2"><TextBlock Text="G" FontSize="25" FontWeight="Bold" TextAlignment="Center"/></Border>
       <Border Background="#111827" CornerRadius="8" Padding="8" Margin="2"><TextBlock Text="D" FontSize="25" FontWeight="Bold" TextAlignment="Center"/></Border>
       <Border Background="#111827" CornerRadius="8" Padding="8" Margin="2"><TextBlock Text="Em" FontSize="25" FontWeight="Bold" TextAlignment="Center"/></Border>
       <Border Background="#111827" CornerRadius="8" Padding="8" Margin="2"><TextBlock Text="C" FontSize="25" FontWeight="Bold" TextAlignment="Center"/></Border>
      </UniformGrid>
      <TextBlock Text="실제 곡의 코드 데이터가 연결되면 진행 위치에 맞춰 표시됩니다." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="2,16,2,0"/>
     </StackPanel>
    </Border>
    <Border Grid.Column="1" Background="#202733" CornerRadius="12" Padding="18" Margin="7,0,0,0">
     <StackPanel>
      <TextBlock Text="악보" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
      <Border Background="#F9FAFB" CornerRadius="7" Padding="12" Height="118">
       <Viewbox Stretch="Uniform">
        <Canvas Width="480" Height="100">
         <Line X1="0" Y1="20" X2="480" Y2="20" Stroke="#374151" StrokeThickness="1"/>
         <Line X1="0" Y1="35" X2="480" Y2="35" Stroke="#374151" StrokeThickness="1"/>
         <Line X1="0" Y1="50" X2="480" Y2="50" Stroke="#374151" StrokeThickness="1"/>
         <Line X1="0" Y1="65" X2="480" Y2="65" Stroke="#374151" StrokeThickness="1"/>
         <Line X1="0" Y1="80" X2="480" Y2="80" Stroke="#374151" StrokeThickness="1"/>
         <TextBlock Canvas.Left="12" Canvas.Top="27" Text="♪" FontSize="38" Foreground="#374151"/>
         <Ellipse Canvas.Left="120" Canvas.Top="56" Width="13" Height="9" Fill="#16A34A"/>
         <Ellipse Canvas.Left="180" Canvas.Top="41" Width="13" Height="9" Fill="#374151"/>
         <Ellipse Canvas.Left="240" Canvas.Top="33" Width="13" Height="9" Fill="#374151"/>
         <Ellipse Canvas.Left="300" Canvas.Top="48" Width="13" Height="9" Fill="#374151"/>
         <Line X1="126" Y1="60" X2="126" Y2="12" Stroke="#16A34A" StrokeThickness="2"/>
         <Line X1="186" Y1="45" X2="186" Y2="0" Stroke="#374151" StrokeThickness="2"/>
         <Line X1="246" Y1="37" X2="246" Y2="0" Stroke="#374151" StrokeThickness="2"/>
        </Canvas>
       </Viewbox>
      </Border>
      <TextBlock Text="악보 데이터와 재생 위치를 연결하면 현재 음표가 강조됩니다." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="2,13,2,0"/>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>

  <TextBlock x:Name="StatusText" Grid.Row="3" Text="대기 중 · 방송 주소를 입력해 주세요" Foreground="#9CA3AF" Margin="3,14,0,0" FontSize="12"/>
 </Grid>
</Window>
