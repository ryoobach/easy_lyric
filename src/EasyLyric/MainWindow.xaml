<Window x:Class="EasyLyric.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Easy Lyric" Height="900" Width="1280" MinHeight="720" MinWidth="980"
 WindowStartupLocation="CenterScreen" Background="#111827" Foreground="#F9FAFB">
 <Grid Margin="18">
  <TabControl Background="#202733" Foreground="#F9FAFB">
   <TabItem Header="방송 모니터">
    <Grid Margin="16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,14">
      <TextBlock Text="Easy Lyric" FontSize="28" FontWeight="Bold"/>
      <TextBlock Text="실시간 가사 · 기타 코드 · 악보 도우미" Foreground="#9CA3AF"/>
     </StackPanel>
     <Grid Grid.Row="1" Background="#111827" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="방송 주소" VerticalAlignment="Center" Margin="12"/>
      <ComboBox x:Name="AddressCombo" Grid.Column="1" Height="38" IsEditable="True" IsTextSearchEnabled="False" VerticalContentAlignment="Center"/>
      <Button x:Name="ConnectButton" Grid.Column="2" Content="방송 연결" Width="112" Margin="10,0" Click="ConnectButton_Click"/>
     </Grid>
     <Grid Grid.Row="2">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#111827" CornerRadius="8" Padding="20" Margin="0,0,8,8">
       <StackPanel><TextBlock Text="현재 곡" Foreground="#9CA3AF"/><TextBlock x:Name="SongTitleText" Text="곡 정보 대기 중" FontSize="24" FontWeight="Bold" Margin="0,8"/><TextBlock x:Name="ArtistText" Text="가수 정보 대기 중"/><TextBlock Text="가사 및 곡 인식 기능은 별도 개발 단계입니다." Foreground="#9CA3AF" Margin="0,24,0,0"/></StackPanel>
      </Border>
      <Border Grid.Column="1" Background="#111827" CornerRadius="8" Padding="20" Margin="8,0,0,8">
       <StackPanel><TextBlock Text="기타 코드" FontSize="20" FontWeight="Bold"/><TextBlock Text="코드 분석 대기 중" FontSize="28" Foreground="#86EFAC" Margin="0,18"/><TextBlock Text="실제 오디오 분석 및 코드 검출은 아직 연결되지 않았습니다." Foreground="#9CA3AF" TextWrapping="Wrap"/></StackPanel>
      </Border>
      <TextBlock x:Name="StatusText" Grid.Row="1" Grid.ColumnSpan="2" Text="대기 중" Foreground="#9CA3AF" Margin="2,8"/>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="A4 악보 / 인쇄">
    <Grid Margin="14">
     <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,14,0">
       <TextBlock Text="악보 정보" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>
       <TextBlock Text="곡 제목"/><TextBox x:Name="TitleInput" Height="32" Margin="0,4,0,12" Text="곡 제목"/>
       <TextBlock Text="작사 · 작곡"/><TextBox x:Name="ComposerInput" Height="32" Margin="0,4,0,12" Text="작사 · 작곡"/>
       <TextBlock Text="가수"/><TextBox x:Name="SingerInput" Height="32" Margin="0,4,0,12" Text="가수"/>
       <TextBlock Text="악보 내용 (한 줄에 한 마디씩 입력)" TextWrapping="Wrap"/>
       <TextBox x:Name="ScoreInput" Height="330" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,12"
        Text="| C        | G        | Am       | F        |&#x0a;| C        | G        | F        | C        |&#x0a;| Am       | Em       | F        | G        |&#x0a;| C        | G        | Am       | F        |&#x0a;| C        | G        | F        | C        |"/>
       <Button Content="악보 미리보기 갱신" Height="40" Click="PreviewButton_Click" Margin="0,0,0,8"/>
       <Button Content="인쇄하기" Height="40" Click="PrintButton_Click"/>
       <TextBlock Text="A4 세로 · 첫 페이지에 곡 정보 · 이후 페이지는 악보만 · 모든 페이지 하단 공동제작자 표기" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel>
     </ScrollViewer>
     <Border Grid.Column="1" Background="#374151" Padding="10" CornerRadius="8">
      <DocumentViewer x:Name="ScoreViewer" Background="#6B7280"/>
     </Border>
    </Grid>
   </TabItem>
  </TabControl>
 </Grid>
</Window>